# =================================================================
#  Sietch Metrics — Backend — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores marcados com FILL_ME
#  cp .env.example .env
# =================================================================

# ─── Banco de dados (Supabase / Postgres) ────────────────────────
#
#  Onde encontrar:
#  Supabase → Settings → Database → Connection string
#
#  DATABASE_URL  = Transaction pooler (porta 6543) — usado em runtime/Vercel
#  DIRECT_URL    = Direct connection  (porta 5432) — usado em migrations
#
DATABASE_URL="postgresql://postgres.<project_ref>:FILL_ME@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project_ref>:FILL_ME@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Sessão (JWT em cookie httpOnly) ────────────────────────────
#
#  Gerar JWT_SECRET com:  openssl rand -base64 64
#  (ou use qualquer gerador de string aleatória com 64+ caracteres)
#
JWT_SECRET="FILL_ME"
SESSION_COOKIE_NAME="sietch_session"
SESSION_MAX_AGE_DAYS="7"

# ─── Frontend / CORS ────────────────────────────────────────────
#
#  Em desenvolvimento local deixe como está.
#  Em produção troque pelo domínio real do frontend.
#
FRONTEND_URL="http://localhost:5500"
ALLOWED_ORIGINS="http://localhost:5500,http://localhost:3000,https://sietch-metrics.vercel.app"

# ─── Aplicação ──────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"

# ─── Bootstrap ──────────────────────────────────────────────────
#
#  Email que vira admin automaticamente no primeiro login.
#  Troque pelo email real do administrador do sistema.
#
INITIAL_ADMIN_EMAIL="FILL_ME@suaempresa.com"
